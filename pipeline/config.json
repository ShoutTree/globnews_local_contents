{
  "keys_path": "/home/xiaoqi/Documents/projects/xzengBin/smallTools/news_generate/ai_api_keys.json",

  "text_models": [
    {
      "name": "qwen3.7-flash",
      "api_key_name": "qwen",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "extra_body": { "enable_thinking": false, "enable_search": true, "search_options": { "forced_search": true, "search_strategy": "max" } },
      "comment": "默认：带联网搜索，选题与成文都可交叉核实"
    },
    {
      "name": "deepseek-chat",
      "api_key_name": "deepseek",
      "base_url": "https://api.deepseek.com",
      "extra_body": { "enable_internet": true },
      "comment": "fallback"
    }
  ],

  "image": {
    "backend": "dashscope_qwen_image",
    "comment": "换生图模型只改这里的 backend（或对应 backends.<name>.model）",
    "backends": {
      "dashscope_qwen_image": {
        "type": "dashscope_multimodal",
        "model": "qwen-image-2.1-turbo",
        "size": "1280*720",
        "comment": "写实摄影风格强，同步调用"
      },
      "dashscope_wanx": {
        "type": "dashscope_wanx",
        "model": "wanx2.0-t2i-turbo",
        "size": [1280, 720],
        "comment": "通义万相，异步轮询调用"
      }
    },
    "style_suffix": "Photorealistic documentary-style news photograph, natural lighting, realistic textures and materials, 35mm lens, editorial composition, sharp focus. No text, no captions, no watermarks, no logos, no brand names. Do not show recognizable real people's faces — prefer wide shots, medium shots from behind, silhouettes, or scenes without identifiable individuals."
  },

  "rss_sources": [
