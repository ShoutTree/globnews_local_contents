    { "name": "Guardian Travel",  "url": "https://www.theguardian.com/travel/rss",                       "category_hint": "travel" },
    { "name": "Guardian Sport",   "url": "https://www.theguardian.com/uk/sport/rss",                     "category_hint": "sports" },
